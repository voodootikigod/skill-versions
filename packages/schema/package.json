{
  "name": "@skills-check/schema",
  "version": "1.4.0",
  "description": "Shared types and JSON Schema for skills-check registry format",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema.json": "./dist/schema.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsx src/generate.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "ts-json-schema-generator": "^2.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
