{
  "name": "skills-check",
  "version": "1.4.0",
  "description": "The missing quality toolkit for Agent Skills — like npm outdated for skill knowledge",
  "type": "module",
  "bin": {
    "skills-check": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent-skills",
    "skills-check",
    "freshness",
    "version-check",
    "npm-outdated",
    "cli"
  ],
  "author": "Chris Williams <voodootikigod@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/voodootikigod/skills-check.git",
    "directory": "packages/cli"
  },
  "homepage": "https://skillscheck.ai",
  "dependencies": {
    "ai": "^7.0.8",
    "chalk": "^5.4.1",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "^5.2.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@ai-sdk/anthropic": "^4.0.3",
    "@ai-sdk/google": "^4.0.3",
    "@ai-sdk/openai": "^4.0.4"
  },
  "devDependencies": {
    "@skills-check/schema": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
